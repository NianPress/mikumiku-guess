{
  "name": "mikumiku-guess",
  "account_id": "88baf71d28f610383105fa3e0f797d6a",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/views", "/api/cover", "/api/feedback", "/api/feedback-ticket", "/api/health", "/api/daily", "/api/daily/*", "/api/leaderboard", "/api/rooms", "/api/rooms/*"]
  },
  "observability": {"enabled": true},
  "durable_objects": {"bindings": [{"name":"DAILY","class_name":"DailyChallenge"},{"name":"ROOMS","class_name":"GameRoom"}]},
  "migrations": [{"tag":"game-v1","new_sqlite_classes":["DailyChallenge","GameRoom"]}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikumiku-guess-feedback",
      "database_id": "58a7d6cd-5b59-4908-bca0-ea60a9ba4ded",
      "migrations_dir": "drizzle"
    }
  ]
}
